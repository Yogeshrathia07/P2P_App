# Server Configuration
PORT=5000
NODE_ENV=development

# Real-Time Cloud Database (MongoDB Atlas)
# Replace with your MongoDB Atlas cluster URI for multi-device sync:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/peerforge?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/peerforge

# Security & Authentication
JWT_SECRET=peerforge_super_secret_jwt_key_change_in_production

# Client URL (For CORS when hosted separately)
CLIENT_URL=http://localhost:5173
